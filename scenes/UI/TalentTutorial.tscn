[node name="TalentTutorial" type="CanvasLayer"]
process_mode = 3
layer = 120
script = ExtResource("Script")
headings = PackedStringArray("天赋教学", "切换天赋页", "升级天赋")
explanations = PackedStringArray("天赋可以强化队伍，也能解锁技能的新效果。\n\n右上角显示当前可用的天赋点数。接下来看看如何选择和升级天赋。", "上方可切换主、召、辅、护、攻五页。\n\n主：主角、符咒、三才阵与豆兵。召：召唤物。辅：治疗、支援和金币经验等收益。护与攻：防御和攻击能力。\n\n可以先查看说明，再决定投入哪一页。", "把鼠标移到天赋上，可查看效果、等级和前置条件。点击可升级的天赋，每级消耗1点。\n\n连线表示前置关系，需要先把前置升到指定等级。右键可退回1点；已有后续天赋依赖时，需先退后续。\n\n教学结束后，试着查看并升级一项天赋；也可以保留点数以后使用。")
continue_text = "下一步"
finish_text = "完成教学"

