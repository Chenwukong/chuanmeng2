[node name="TalismanTutorial" type="CanvasLayer"]
process_mode = 3
layer = 120
script = ExtResource("Script")
headings = PackedStringArray("符咒教学", "按 Q / E，切换符咒", "选择目标")
explanations = PackedStringArray("符咒是主角的主要战斗手段。\n\n轮到主角行动时，身旁会出现三张符咒；中间的一张就是当前选中的符咒。下方的名称和数字表示符咒种类及剩余数量。\n\n先记住：选中什么符，主角就使用什么符。", "按 Q 切换到上一种符咒，按 E 切换到下一种，也可以点击两侧的符咒。切换本身不消耗行动。\n\n星火篆用于火焰攻击；冰冻符可控制目标。加速、借尸符等支援符咒则需要选择合适的队友。\n\n根据敌人和队伍的状态，选择需要的符咒。", "没有选择其他战斗指令时，直接点击机关人，即可使用当前符咒。也可以先选择“攻击”，再选择目标。\n\n大部分符咒会消耗符纸，留意名称旁的数量；“无字符”显示 ∞，可以无限使用。\n\n教学结束后，试着切换一种符咒，选择机关人进行攻击。")
continue_text = "下一步"
finish_text = "完成教学"

